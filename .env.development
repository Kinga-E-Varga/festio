# Committed on purpose: no secrets here, only where `npm run dev` looks for data.
# On your machine the app and the seed talk to the local emulators (`npm run emulators`).
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-festio
# The emulator takes any key; the real ones come with `festio-staging` (step 6).
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-festio.firebaseapp.com
# Signs the Protected-password cookie and scrambles visitors' IPs. A dummy for the
# emulators only; the real one comes from Secret Manager with `festio-staging` (step 6).
FESTIO_SECRET=dev-only-not-a-secret
# Invitations open at `<slug>.localhost:3000`, the host app at `localhost:3000`.
NEXT_PUBLIC_BASE_DOMAIN=localhost:3000
