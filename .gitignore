# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-test/
/tests/cost/last-run.md
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# firebase emulators
firebase-debug.log
firestore-debug.log
ui-debug.log
database-debug.log
pubsub-debug.log
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# no secrets: only points `npm run dev` at the local emulators
!.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# implementation plans — never committed
/context/plans/

# market research and background notes — never committed
/context/research/

# session handoff notes — never committed
/context/handoffs/

# superpowers scratch (visual companion mockups, subagent workspaces) — never committed
/.superpowers/
